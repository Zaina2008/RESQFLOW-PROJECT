{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "site_name": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "information"
      ],
      "enumColors": [
        "red",
        "yellow",
        "blue"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "enumColors": [
        "red",
        "yellow",
        "green"
      ]
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "severity",
    "detected_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
